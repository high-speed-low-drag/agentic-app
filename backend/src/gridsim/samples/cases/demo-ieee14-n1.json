{
  "id": "demo-ieee14-n1",
  "name": "IEEE 14 – rated, line 2–4 outage",
  "description": "The IEEE 14-bus network in a January week with +20 % demand and line 2–4 out for maintenance. Look at the Violations tab and branch loading: line 4–5 is overloaded through every weekday (07–22 h) and lines 2–5, 2–3 and 1–5 at the evening peak, while the generators hold all voltages within 0.95–1.10 pu. The network edits are deliberate: the file has no branch ratings, so each branch is rated at 1.3x its base-case flow (rounded up to 5 MVA), and line 2–4 is switched out on both ends.",
  "network": {
    "source": "sample",
    "key": "ieee14"
  },
  "time": {
    "start": "2027-01-11T00:00:00",
    "end": "2027-01-18T00:00:00",
    "resolution_minutes": 60
  },
